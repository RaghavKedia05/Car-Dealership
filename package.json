{
  "name": "car-dealership-inventory",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "concurrently \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --watch backend/server.js",
    "dev:web": "vite --host 0.0.0.0",
    "build": "vite build",
    "start": "node backend/server.js",
    "test": "node --test",
    "test:coverage": "node --experimental-test-coverage --test",
    "seed:admin": "node backend/seed-admin.js",
    "db:import:postgres": "node scripts/migrate-sqlite-to-postgres.js",
    "stress": "node scripts/http-load-check.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.23.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.1",
    "lucide-react": "^0.468.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "supertest": "^7.1.4",
    "vite": "^7.1.9"
  }
}
