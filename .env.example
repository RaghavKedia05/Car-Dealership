JWT_SECRET=change-me
HOST_PORT=3001
# Set DATABASE_URL to use PostgreSQL (Neon pooled connection string for hosted APIs); otherwise local development uses SQLite.
DATABASE_URL=
DATABASE_POOL_MAX=5
# Comma-separated exact frontend origins for cross-origin browser access.
# CORS_ORIGINS=https://car-dealership-sand.vercel.app
# Set this in Vercel at build time when the API is hosted separately.
VITE_API_BASE_URL=
# Deterministic parsing is the default and does not send queries to an external service.
AI_PROVIDER=deterministic
# Optional OpenAI-compatible parsing. Set AI_PROVIDER=openai-compatible and configure both values.
AI_API_KEY=
AI_MODEL=
# AI_BASE_URL=https://api.openai.com/v1/chat/completions
# Set only behind a trusted reverse proxy; use the exact hop count (0 disables trust).
# TRUST_PROXY_HOPS=1
