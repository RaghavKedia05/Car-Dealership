JWT_SECRET=change-me
HOST_PORT=3001
# Set DATABASE_URL to use PostgreSQL (Neon pooled connection string for hosted APIs); otherwise local development uses SQLite.
DATABASE_URL=
DATABASE_POOL_MAX=5
# Optional one-time administrator bootstrap on API startup. Remove these from the API host after the first successful deploy.
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=use-a-unique-password-of-at-least-12-characters
# ADMIN_NAME=Dealership Admin
# Comma-separated exact frontend origins for cross-origin browser access.
# CORS_ORIGINS=https://car-dealership-sand.vercel.app
# Set this in Vercel at build time when the API is hosted separately.
VITE_API_BASE_URL=
# Deterministic parsing is the default and does not send queries to an external service.
AI_PROVIDER=deterministic
# Razorpay Standard Checkout. Keep all payment secrets on the API host, never in VITE_ variables.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Registration OTP and password reset email delivery (Resend). APP_ORIGIN is the exact HTTPS Vercel origin.
RESEND_API_KEY=
PASSWORD_RESET_FROM=
APP_ORIGIN=
# Optional OpenAI-compatible parsing. Set AI_PROVIDER=openai-compatible and configure both values.
AI_API_KEY=
AI_MODEL=
# AI_BASE_URL=https://api.openai.com/v1/chat/completions
# Set only behind a trusted reverse proxy; use the exact hop count (0 disables trust).
# TRUST_PROXY_HOPS=1
